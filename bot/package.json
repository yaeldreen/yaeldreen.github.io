{
  "name": "tsukuyomi-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "seed:game-data": "tsx --env-file=.env src/seed-game-data.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.28.0",
    "firebase-admin": "^13.6.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
