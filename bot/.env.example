# Copier en .env (jamais commité) et remplir.

# Jeton du bot (Discord Developer Portal → Bot → Reset Token). Secret : ne jamais le partager.
DISCORD_TOKEN=

# Clé du compte de service Firebase (console Firebase → Paramètres du projet → Comptes de service → Générer une clé).
# Secret : elle donne tous les droits sur la base.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Identifiant du serveur du clan (clic droit sur le serveur → Copier l'identifiant) : commandes « / » disponibles tout de suite.
ID_SERVEUR=

# Rôle Discord autorisé à modifier les données de jeu (!ajouterNiveau).
EDITOR_ROLE=Éditeur HUB

# Nom du salon de chaque onglet.
CHANNEL_BUILD_GUIDE=build-guide
CHANNEL_SIMU_CONSTRU=simu-constru
CHANNEL_SIMU_COMBAT=simu-combat
CHANNEL_RETOURS=retours
CHANNEL_GESTION_JOUEURS=gestion-joueurs
CHANNEL_PLUS_PROCHE=plus-proche
CHANNEL_INFOS_ENNEMIS=infos-ennemis
CHANNEL_PILLAGES=pillages
CHANNEL_CALCUL_SECONDE=calcul-seconde
CHANNEL_SIMU_RAZ=simu-raz
