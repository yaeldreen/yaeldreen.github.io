rules_version = '2';

// Règles de sécurité Firestore de Tsukuyomi HUB (carte et joueurs, clans).
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
//
// Lecture et écriture ouvertes à tous (choix assumé : données non sensibles).
// Seule la forme des données est contrôlée, pour éviter le contenu mal formé.
service cloud.firestore {
  match /databases/{database}/documents {
    function isTroopCount(value) {
      return value is int && value >= 0;
    }

    function isName(value) {
      return value is string && value.size() > 0 && value.size() <= 64;
    }

    // Niveau de bâtiment saisi à la main : absent, vide ou entre 0 et 20.
    function isOptionalLevel(data, field) {
      return !(field in data) || data[field] == null || (data[field] is int && data[field] >= 0 && data[field] <= 20);
    }

    match /clans/{clan} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name']) && isName(request.resource.data.name);
    }

    function isValidArmy(army) {
      return army.keys().hasOnly(['troops', 'side', 'updatedAt'])
        && isTroopCount(army.troops.genin)
        && isTroopCount(army.troops.chuunin)
        && isTroopCount(army.troops.jounin)
        && (army.side == null || army.side in ['Assaillant', 'Défenseur'])
        && army.updatedAt is string;
    }

    // Carte du jeu, importée depuis « MAJ joueurs », avec l'armée et les infos saisies à la main sur chaque joueur.
    function isValidVillage(data) {
      return data.keys().hasOnly([
          'name', 'kage', 'x', 'y', 'clan', 'points', 'inhabitants', 'neutral',
          'gameId', 'army', 'ce', 'academy', 'chunninCenter', 'jouninCenter', 'hospital', 'wall',
          'createdAt', 'comment', 'commentBy', 'commentAt'
        ])
        && isName(data.name)
        && isName(data.kage)
        && (!('gameId' in data) || data.gameId is int)
        && (!('army' in data) || isValidArmy(data.army))
        // Sans coordonnées : joueur ajouté à la main, absent de la carte.
        && (!('x' in data) || data.x is int)
        && (!('y' in data) || data.y is int)
        && (data.clan == null || isName(data.clan))
        && isTroopCount(data.points)
        && isTroopCount(data.inhabitants)
        && data.neutral is bool
        && isOptionalLevel(data, 'ce')
        && isOptionalLevel(data, 'academy')
        && isOptionalLevel(data, 'chunninCenter')
        && isOptionalLevel(data, 'jouninCenter')
        && isOptionalLevel(data, 'hospital')
        && isOptionalLevel(data, 'wall')
        && (!('createdAt' in data) || data.createdAt is string)
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 500));
    }

    match /villages/{village} {
      allow read, delete: if true;
      allow create, update: if isValidVillage(request.resource.data);
    }

    // Simu raz partagé : un seul raz en cours, modifiable par tout le monde.
    match /raz/{room} {
      allow read: if true;
      allow create, update: if room == 'current'
        && request.resource.data.keys().hasOnly(['defender', 'attackers', 'simulated', 'updatedAt']);
    }

    // Données de jeu (bâtiments, vitesses, règles de combat…) : le bot Discord les modifie avec le compte de service.
    // Seul le guide des bâtiments se modifie depuis l'appli : un bâtiment à la fois, sans jamais en retirer.
    match /gameData/{part} {
      allow read: if true;
      allow update: if part == 'buildings'
        && request.resource.data.keys().hasAll(resource.data.keys())
        && request.resource.data.diff(resource.data).affectedKeys().size() <= 3;
      allow create, delete: if false;
    }

    // Historique des modifications du temps et des ressources des bâtiments : ajout seulement, consultable depuis la console.
    match /buildingHistory/{entry} {
      allow create: if request.resource.data.keys().hasOnly(['building', 'level', 'before', 'after', 'at'])
        && isName(request.resource.data.building)
        && request.resource.data.level is int
        && (request.resource.data.before == null || request.resource.data.before is map)
        && request.resource.data.after is map
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    // Réglages des membres Discord (village, CE) : seul le bot y accède, avec le compte de service.
    match /discordUsers/{user} {
      allow read, write: if false;
    }

    // Témoin de la copie initiale des joueurs : créé une seule fois, jamais modifié.
    match /meta/seed {
      allow read, create: if true;
    }

    // Tour de contrôle : lignes du journal d'attaques du clan, enregistrées par la fenêtre relais de l'appli.
    // Création seulement (une ligne déjà vue n'est pas réécrite) ; suppression possible pour faire le ménage.
    match /watchtower/{line} {
      allow read, delete: if true;
      allow create: if request.resource.data.keys().hasOnly(['minute', 'text', 'from', 'to', 'precise', 'exact', 'direction'])
        && request.resource.data.minute is string && request.resource.data.minute.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.from is int && request.resource.data.to is int
        && request.resource.data.from <= request.resource.data.to
        && request.resource.data.precise is bool
        && request.resource.data.exact is bool
        && request.resource.data.direction is string && request.resource.data.direction.size() <= 20;
    }

    // Attaques des villages neutres, relevées par le script des pillages : ajout seulement, une attaque garde son identifiant
    // (village, heure, attaquant), donc la même attaque ne peut pas être enregistrée deux fois.
    match /neutralRaids/{raid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['village', 'villageName', 'attacker', 'attackerVillageId', 'mode', 'at'])
        && request.resource.data.village is int && request.resource.data.village < 0
        && request.resource.data.villageName is string && request.resource.data.villageName.size() <= 64
        && isName(request.resource.data.attacker)
        && request.resource.data.attackerVillageId is int
        && request.resource.data.mode in ['pillage', 'attaque']
        && request.resource.data.at is string && request.resource.data.at.size() <= 30;
      allow update, delete: if false;
    }

    // Dernière actualisation des pillages : une par heure au plus pour tout le clan, à l'heure du serveur.
    match /neutralRaidsRefresh/{doc} {
      allow read: if true;
      allow create: if doc == 'last' && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow update: if doc == 'last' && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
        && request.time > resource.data.at + duration.value(1, 'h');
    }

    // Relevés mensuels des points et habitants (« current » = mois en cours, « previous » = mois précédent).
    match /snapshots/{slot} {
      allow read: if true;
      allow write: if slot in ['current', 'previous']
        && request.resource.data.keys().hasOnly(['month', 'takenAt', 'players'])
        && request.resource.data.month is string && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.takenAt is string
        && request.resource.data.players is list && request.resource.data.players.size() <= 5000;
    }

    // Mot de passe d'accès (empreinte SHA-256) : il ne se change que depuis la console Firebase.
    match /meta/access {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
